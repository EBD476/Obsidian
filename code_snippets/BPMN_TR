EndErrorEvent.title = رویداد پایان خطا
EndNoneEvent.description = رویداد پایان بدون نوع معمولاً پایان استاندارد یک فرآیند را علامت‌گذاری می‌کند.
EndNoneEvent.title = رویداد پایان
